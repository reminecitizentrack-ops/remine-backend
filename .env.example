# ==================== SERVEUR ====================
PORT=5000
NODE_ENV=production

# ==================== MONGODB RAILWAY ====================
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_password_here
MONGOHOST=railway-private-domain
MONGOPORT=27017
MONGOUSER=mongo
MONGOPASSWORD=your_mongodb_password_here
MONGO_URL=mongodb://mongo:password@railway-private-domain:27017/remine
MONGO_PUBLIC_URL=mongodb://mongo:password@railway-tcp-proxy-domain:railway-tcp-proxy-port/remine

# ==================== SÉCURITÉ ====================
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ==================== FRONTEND ====================
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ==================== RAILWAY ====================
RAILWAY_PUBLIC_URL=https://your-app.railway.app
RAILWAY_STATIC_URL=your-app.railway.app